# PostgreSQL connection used by the application.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true"

# Direct/session connection used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Public Supabase values used to create SSR and browser Auth clients.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"

# Server-only key used by the development seed to create Auth users.
SUPABASE_SECRET_KEY="YOUR_SUPABASE_SECRET_KEY"

# Development login password for seeded accounts. Use at least 12 characters.
SEED_USER_PASSWORD="YOUR_SECURE_DEVELOPMENT_PASSWORD"
